{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cheetah-focused-query@v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lookups",
    "needs_more_context",
    "missing_snippets",
    "stop_reason"
  ],
  "properties": {
    "lookups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "relation",
          "direction"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "pattern": "^(focus|e[1-9][0-9]*_(subject|object))$",
            "maxLength": 24
          },
          "relation": {
            "type": "string",
            "maxLength": 64
          },
          "direction": {
            "type": "string",
            "enum": [
              "out",
              "in"
            ]
          }
        }
      }
    },
    "needs_more_context": {
      "type": "boolean"
    },
    "missing_snippets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "stop_reason": {
      "type": "string"
    }
  }
}
