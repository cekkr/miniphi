{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cheetah-graph-reason@v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lookups", "answer_entity", "evidence_ids", "needs_more_context", "missing_snippets", "stop_reason"],
  "properties": {
    "lookups": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entity", "relation", "direction"],
        "properties": {
          "entity": {"type": "string", "minLength": 1, "maxLength": 200},
          "relation": {"type": "string", "maxLength": 64},
          "direction": {"type": "string", "enum": ["out", "in"]}
        }
      }
    },
    "answer_entity": {"type": "string", "maxLength": 200},
    "evidence_ids": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "needs_more_context": {"type": "boolean"},
    "missing_snippets": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
    "stop_reason": {"type": "string"}
  }
}
